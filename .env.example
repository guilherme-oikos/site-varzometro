# Variáveis opcionais. O site funciona sem nenhuma delas.
# Para usar: copie este arquivo como ".env.local" e preencha.

# Chave da API do YouTube. OBRIGATÓRIA em produção.
# Sem ela o site tenta ler as páginas públicas do canal. Isso funciona da sua
# máquina, mas o YouTube bloqueia IP de datacenter: na Vercel a busca falha e o
# site congela na lista manual do site.ts.
# Com ela, os cards mostram duração real e views, e a classificação entre
# episódio e corte fica exata.
# Como gerar: console.cloud.google.com > criar projeto > ativar "YouTube Data
# API v3" > Credenciais > Criar credenciais > Chave de API. É gratuito.
YOUTUBE_API_KEY=

# ID do canal. Só mexa se o canal mudar.
YOUTUBE_CHANNEL_ID=UCq6n9H-_wGp-W8NZ_KTklhA

# ---------------------------------------------------------------- Supabase --
# Login da bancada, perfis e artigos. Sem as duas primeiras, o site lê os
# artigos de content/posts/ e a bancada do site.ts, e o painel fica desligado.
# Onde pegar: supabase.com > seu projeto > Settings > API.
# As duas NEXT_PUBLIC_ vão para o navegador de propósito; quem protege os dados
# é a RLS do banco (supabase/migrations/0001_inicial.sql).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Só para rodar `npm run migrar` na sua máquina. Passa por cima de todas as
# regras do banco: NUNCA coloque na Vercel e nunca com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Bolão --
# Token do football-data.org, de onde vêm os jogos e placares do Brasileirão.
# Gratuito: cadastre em football-data.org/client/register e o token chega por
# e-mail. Vai na Vercel e no .env.local. Sem ele, o bolão fica parado no que já
# está no banco (o admin ainda corrige placar à mão).
FOOTBALL_DATA_TOKEN=

# Senha do agendamento diário que impede o Supabase grátis de pausar
# (/api/manter-ativo) e da sincronização do bolão (/api/bolao/sincronizar).
# Qualquer texto longo e aleatório. Na Vercel, e o mesmo valor gravado no banco
# com `select public.bolao_definir_segredo('...')` (ver SUPABASE.md).
CRON_SECRET=
